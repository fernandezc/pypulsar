; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

#define MyAppName "pyPulsar"
#define MyAppVerName "pyPulsar-0.2.196"
#define MyAppURL "http://www-lcs.ensicaen.fr/pypulsar"
#define MyAppExeName "pypulsar.exe"
#define MyApp "dist"
[Setup]
AppName={#MyAppName}
AppVerName={#MyAppVerName}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={pf}\pypulsar
DefaultGroupName={#MyAppName}
AllowNoIcons=true
LicenseFile=COPYING.rtf
InfoBeforeFile=README.rtf
InfoAfterFile=NEWS.rtf
OutputBaseFilename=setup-{#MyAppVerName}
Compression=lzma
SolidCompression=true
ShowLanguageDialog=auto
LanguageDetectionMethod=locale
WindowVisible=true
BackColor=clSilver
SetupIconFile=dist\images\pypulsar.ico
ChangesAssociations=true
WizardImageFile=dist\images\pypulsar-installer.bmp
WizardSmallImageFile=dist\images\pypulsar-installer-small.bmp
WizardImageStretch=true
VersionInfoVersion=0.2.196
VersionInfoCopyright=2006-2007 C. Fernandez & J.P. Amoureux
AppCopyright=2006-2007 C. Fernandez & J.P. Amoureux
UninstallDisplayIcon={app}\dist\images\pypulsar-uninstaller.ico
OutputDir=setup
InternalCompressLevel=ultra
[Languages]
Name: english; MessagesFile: compiler:Default.isl
Name: french; MessagesFile: compiler:Languages\French.isl

[Tasks]
Name: desktopicon; Description: {cm:CreateDesktopIcon}; GroupDescription: {cm:AdditionalIcons}; Flags: unchecked
Name: quicklaunchicon; Description: {cm:CreateQuickLaunchIcon}; GroupDescription: {cm:AdditionalIcons}

[Files]
Source: {#MyApp}\pypulsar.exe; DestDir: {app}; Flags: ignoreversion; Tasks: ; Languages: 
Source: {#MyApp}\*; DestDir: {app}; Flags: ignoreversion recursesubdirs createallsubdirs promptifolder
Source: dist\workspace\*.pul; DestDir: {app}\workspace; Flags: ignoreversion recursesubdirs createallsubdirs promptifolder uninsneveruninstall
; NOTE: Don't use "Flags: ignoreversion" on any shared system files
Source: dist\README.rtf; DestDir: {app}; Flags: isreadme
Source: dist\COPYING.rtf; DestDir: {app}
Source: dist\INSTALL.rtf; DestDir: {app}
Source: dist\NEWS.rtf; DestDir: {app}
Source: dist\CHANGES.rtf; DestDir: {app}
Source: dist\images\pypulsar.ico; DestDir: {app}\images
Source: dist\images\pypulsar-file.ico; DestDir: {app}\images
Source: dist\images\pypulsar-uninstaller.ico; DestDir: {app}\images
Source: dist\images\pypulsar-installer.ico; DestDir: {app}\images
Source: dist\images\pypulsar-logo.jpg; DestDir: {app}\images
Source: dist\README.html; DestDir: {app}
Source: dist\AUTHORS.rtf; DestDir: {app}
Source: dist\images\pypulsar-online.ico; DestDir: {app}\images
Source: dist\pypulsar.cfg; DestDir: {app}
Source: dist\workspace\lastfile.cfg; DestDir: {app}\workspace

[Icons]
Name: {userdesktop}\{#MyAppName}; Filename: {app}\pypulsar.exe; Tasks: desktopicon; IconFilename: {app}\images\pypulsar.ico; WorkingDir: {app}; IconIndex: 0
Name: {userappdata}\Microsoft\Internet Explorer\Quick Launch\{#MyAppName}; Filename: {app}\pypulsar.exe; Tasks: quicklaunchicon; IconFilename: {app}\images\pypulsar.ico; WorkingDir: {app}; IconIndex: 0
Name: {group}\README; Filename: {app}\README.rtf; WorkingDir: {app}; Comment: README; Flags: createonlyiffileexists
Name: {group}\COPYING; Filename: {app}\COPYING.rtf; WorkingDir: {app}; Comment: COPYING; Flags: createonlyiffileexists
Name: {group}\{#MyAppName}; Filename: {app}\pypulsar.exe; IconFilename: {app}\images\pypulsar.ico; WorkingDir: {app}; Tasks: " quicklaunchicon desktopicon"; IconIndex: 0
Name: {group}\{cm:UninstallProgram,{#MyAppName}}; Filename: {uninstallexe}; IconFilename: {app}\images\pypulsar-uninstaller.ico; IconIndex: 0
Name: {group}\pypulsar Website; Filename: {app}\pypulsar website.url; IconFilename: {app}\images\pypulsar-online.ico; Tasks: " quicklaunchicon desktopicon"; IconIndex: 0

[Run]
Filename: {app}\{#MyAppExeName}; Description: {cm:LaunchProgram,{#MyAppName}}; Flags: nowait postinstall skipifsilent; Tasks: ; Languages: ; WorkingDir: {app}

[INI]
Filename: {app}\pypulsar Website.url; Section: InternetShortcut; Key: URL; String: http://www-lcs.ensicaen.fr/pypulsar; Flags: uninsdeleteentry

[UninstallDelete]
Type: files; Name: {app}\pypulsar Web Site.url
Type: files; Name: {app}\pypulsar Website.url
Name: matplotlibdata; Type: filesandordirs
Name: scipy; Type: filesandordirs
[Registry]
Root: HKCR; SubKey: .pul; ValueType: string; ValueData: Pulsar script; Flags: uninsdeletekey
Root: HKCR; SubKey: Pulsar script; ValueType: string; ValueData: Script input file for pypulsar; Flags: uninsdeletekey
Root: HKCR; SubKey: Pulsar script\Shell\Open\Command; ValueType: string; ValueData: """{app}\pypulsar.exe"" ""%1"""; Flags: uninsdeletevalue
Root: HKCR; Subkey: Pulsar script\DefaultIcon; ValueType: string; ValueData: {app}\images\pypulsar-File.ico,0; Flags: uninsdeletevalue uninsdeletekeyifempty
[_ISTool]
UseAbsolutePaths=true
[Messages]
SetupAppTitle=pypulsar :  a simulation program for solid-state NMR
WizardInfoAfter=Information / News
ButtonInstall=&Install pypulsar
