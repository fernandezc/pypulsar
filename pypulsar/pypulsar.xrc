          <bitmap>images\icons\cursor.gif</bitmap>
          <accel>F7</accel>
          <help>Stop moving or zooming</help>
          <radio>1</radio>
          <XRCED>
            <events>EVT_MENU|EVT_UPDATE_UI</events>
            <assign_var>1</assign_var>
          </XRCED>
        </object>
        <object class="wxMenuItem" name="SPECTRUM_ZOOM">
          <label>Zoom</label>
          <bitmap>images\icons\zoom.gif</bitmap>
          <accel>F6</accel>
          <help>Zoom the rectangle area</help>
          <radio>1</radio>
          <XRCED>
            <events>EVT_MENU|EVT_UPDATE_UI</events>
            <assign_var>1</assign_var>
          </XRCED>
        </object>
        <object class="wxMenuItem" name="SPECTRUM_PAN">
          <label>Move</label>
          <bitmap>images\icons\pan.gif</bitmap>
          <accel>F5</accel>
          <help>Pan with left, zoom with right</help>
          <radio>1</radio>
          <XRCED>
            <events>EVT_MENU|EVT_UPDATE_UI</events>
            <assign_var>1</assign_var>
          </XRCED>
        </object>
        <object class="separator"/>
        <object class="wxMenuItem" name="SPECTRUM_UNDO">
          <label>Undo</label>
          <bitmap>images\icons\undo_edit.gif</bitmap>
          <accel>CTRL+Z</accel>
          <help>Undo last editing</help>
          <XRCED>
            <events>EVT_MENU|EVT_UPDATE_UI</events>
            <assign_var>1</assign_var>
          </XRCED>
        </object>
        <object class="wxMenuItem" name="SPECTRUM_REDO">
          <label>Redo</label>
          <bitmap>images\icons\redo_edit.gif</bitmap>
          <accel>CTRL+Y</accel>
          <help>Redo last change</help>
          <XRCED>
            <events>EVT_MENU|EVT_UPDATE_UI</events>
            <assign_var>1</assign_var>
          </XRCED>
        </object>
        <object class="wxMenuItem" name="SPECTRUM_RESET">
          <label>Reset</label>
          <bitmap>images\icons\reset.gif</bitmap>
          <accel>CTRL+SHIFT+Z</accel>
          <help>Reset original view</help>
          <XRCED>
            <events>EVT_MENU|EVT_UPDATE_UI</events>
            <assign_var>1</assign_var>
          </XRCED>
        </object>
        <object class="separator"/>
        <label>Spectrum</label>
        <object class="wxMenuItem" name="SPECTRUM_BROADENING">
          <label>Line broadening</label>
          <bitmap>images\icons\variable.gif</bitmap>
          <help>Define and apply line broadening</help>
          <XRCED>
            <events>EVT_MENU|EVT_UPDATE_UI</events>
            <assign_var>1</assign_var>
          </XRCED>
        </object>
      </object>
      <object class="wxMenu" name="MenuOptions">
        <object class="wxMenu" name="MenuLog">
          <label>Adjust log level</label>
          <object class="wxMenuItem" name="OPTIONS_LOGERROR">
            <label>Error log level</label>
            <help>No log output : Script runs silently</help>
            <radio>1</radio>
            <XRCED>
              <events>EVT_MENU|EVT_UPDATE_UI</events>
              <assign_var>1</assign_var>
            </XRCED>
          </object>
          <help>Set log level for the information to display in the console window</help>
          <object class="wxMenuItem" name="OPTIONS_LOGWARNING">
            <label>Warning log level</label>
            <help>Alert for errors and warning only</help>
            <radio>1</radio>
            <XRCED>
              <events>EVT_MENU|EVT_UPDATE_UI</events>
              <assign_var>1</assign_var>
            </XRCED>
          </object>
          <object class="wxMenuItem" name="OPTIONS_LOGINFO">
            <label>Info log level</label>
            <help>Display some informations about the running calculation</help>
            <radio>1</radio>
            <checked>1</checked>
            <XRCED>
              <events>EVT_MENU|EVT_UPDATE_UI</events>
              <assign_var>1</assign_var>
            </XRCED>
          </object>
          <object class="wxMenuItem" name="OPTIONS_LOGVERBOSE">
            <label>Verbose log level</label>
            <help>A lot info will be displayed (Warning: this  affect speedness of calculation)</help>
            <radio>1</radio>
            <XRCED>
              <events>EVT_MENU|EVT_UPDATE_UI</events>
              <assign_var>1</assign_var>
            </XRCED>
          </object>
          <object class="wxMenuItem" name="OPTIONS_LOGDEBUG">
            <label>Debug</label>
            <help>Reserved to developpers</help>
            <radio>1</radio>
            <XRCED>
              <events>EVT_MENU|EVT_UPDATE_UI</events>
              <assign_var>1</assign_var>
            </XRCED>
          </object>
        </object>
        <label>Options</label>
      </object>
      <object class="wxMenu" name="MenuHelp">
        <object class="wxMenuItem" name="HELP_CONTEXT">
          <label>Help on ...</label>
          <bitmap>images\icons\help_context.gif</bitmap>
          <accel>F1</accel>
          <help>Context help</help>
          <XRCED>
            <events>EVT_MENU|EVT_UPDATE_UI</events>
            <assign_var>1</assign_var>
          </XRCED>
        </object>
        <object class="wxMenuItem" name="HELP_DOC">
          <label>Online documentation</label>
          <bitmap>images\icons\help_doc.gif</bitmap>
          <accel>F12</accel>
          <help>Online documention</help>
          <XRCED>
            <events>EVT_MENU|EVT_UPDATE_UI</events>
            <assign_var>1</assign_var>
          </XRCED>
        </object>
        <object class="wxMenuItem" name="HELP_ABOUT">
          <label>About pyPulsar</label>
          <bitmap>images\icons\help_about.gif</bitmap>
          <XRCED>
            <events>EVT_MENU|EVT_UPDATE_UI</events>
            <assign_var>1</assign_var>
          </XRCED>
        </object>
        <label>Help</label>
      </object>
    </object>
    <size>950, 700</size>
    <centered>1</centered>
    <style>wxDEFAULT_FRAME_STYLE</style>
  </object>
  <object class="wxDialog" name="InfoDlg">
    <object class="wxBoxSizer">
      <orient>wxVERTICAL</orient>
      <object class="sizeritem">
        <object class="wxTextCtrl" name="_INFO">
          <value>INFORMATION</value>
          <fg>#400040</fg>
          <bg>#EFEFEF</bg>
          <style>wxNO_BORDER|wxTE_READONLY|wxTE_CENTRE</style>
          <XRCED>
            <assign_var>1</assign_var>
          </XRCED>
        </object>
        <option>0</option>
        <flag>wxALL|wxALIGN_CENTRE|wxALIGN_CENTRE_VERTICAL|wxALIGN_CENTRE_HORIZONTAL|wxADJUST_MINSIZE</flag>
        <border>8</border>
        <minsize>400,20</minsize>
      </object>
    </object>
    <size>300,50</size>
    <title>Plotting...</title>
    <centered>1</centered>
    <icon stock_id="wxART_INFORMATION"/>
    <style>wxSIMPLE_BORDER|wxDEFAULT_DIALOG_STYLE|wxSTAY_ON_TOP</style>
  </object>
</resource>