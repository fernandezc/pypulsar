<?xml version="1.0" encoding="ISO-8859-1"?>
<resource>
  <!--Pypulsar Ressources-->
  <object class="wxDialog" name="SearchDlg">
    <object class="wxBoxSizer">
      <orient>wxVERTICAL</orient>
      <object class="sizeritem">
        <object class="wxBoxSizer">
          <orient>wxHORIZONTAL</orient>
          <object class="sizeritem">
            <object class="wxBoxSizer">
              <orient>wxVERTICAL</orient>
              <object class="sizeritem">
                <object class="wxStaticBoxSizer">
                  <label>Search String</label>
                  <orient>wxHORIZONTAL</orient>
                  <object class="sizeritem">
                    <object class="wxTextCtrl" name="ID_SEARCH_STRING">
                      <XRCED>
                        <assign_var>1</assign_var>
                      </XRCED>
                    </object>
                    <option>1</option>
                    <flag>wxEXPAND</flag>
                  </object>
                </object>
                <option>0</option>
                <flag>wxEXPAND</flag>
              </object>
              <object class="sizeritem">
                <object class="wxStaticBoxSizer">
                  <label>Replace string</label>
                  <orient>wxHORIZONTAL</orient>
                  <object class="sizeritem">
                    <object class="wxTextCtrl" name="ID_REPLACE_STRING">
                      <XRCED>
                        <assign_var>1</assign_var>
                      </XRCED>
                    </object>
                    <option>1</option>
                    <flag>wxEXPAND</flag>
                  </object>
                </object>
                <option>0</option>
                <flag>wxEXPAND</flag>
              </object>
              <object class="sizeritem">
                <object class="wxStaticText" name="ID_FOUND">
                  <label>INFO: You can use regular expressions in your search string!</label>
                  <size>200,30</size>
                  <style/>
                  <fg>#8000FF</fg>
                </object>
                <option>1</option>
                <flag>wxALL|wxEXPAND</flag>
                <border>5</border>
              </object>
            </object>
            <option>1</option>
            <flag>wxALL|wxEXPAND</flag>
            <border>6</border>
          </object>
          <object class="sizeritem">
            <object class="wxBoxSizer">
              <object class="sizeritem">
                <object class="wxRadioBox" name="ID_DIRECTION">
                  <label>Search direction</label>
                  <dimension>0</dimension>
                  <content>
                    <item>From Top</item>
                    <item>Forward</item>
                    <item>Backward</item>
                    <item>In Selection</item>
                  </content>
                  <selection>0</selection>
                  <dimension>0</dimension>
                  <style>wxRA_SPECIFY_ROWS</style>
                  <XRCED>
                    <assign_var>1</assign_var>
                  </XRCED>
                </object>
                <option>0</option>
                <flag>wxEXPAND|wxALIGN_RIGHT</flag>
                <border>5</border>
              </object>
              <orient>wxVERTICAL</orient>
            </object>
            <option>0</option>
            <flag>wxTOP|wxBOTTOM|wxRIGHT|wxEXPAND</flag>
            <border>5</border>
          </object>
        </object>
        <option>1</option>
        <flag>wxEXPAND</flag>
      </object>
      <object class="sizeritem">
        <object class="wxBoxSizer">
          <orient>wxHORIZONTAL</orient>
          <object class="sizeritem">
            <object class="wxButton" name="ID_SEARCH_BUTTON">
              <label>Search...</label>
              <XRCED>
                <assign_var>1</assign_var>
              </XRCED>
            </object>
            <option>0</option>
            <flag>wxEXPAND</flag>
          </object>
          <object class="sizeritem">
            <object class="wxButton" name="ID_REPLACE_BUTTON">
              <label>Replace...</label>
              <XRCED>
                <assign_var>1</assign_var>
              </XRCED>
            </object>
            <option>0</option>
            <flag>wxEXPAND</flag>
          </object>
          <object class="sizeritem">
            <object class="wxButton" name="ID_REPLACESEARCH_BUTTON">
              <label>Replace and Search...</label>
              <XRCED>
                <assign_var>1</assign_var>
              </XRCED>
            </object>
            <option>0</option>
            <flag>wxEXPAND</flag>
          </object>
          <object class="sizeritem">
            <object class="wxButton" name="ID_REPLACEALL_BUTTON">
              <label>Replace All...</label>
              <XRCED>
                <assign_var>1</assign_var>
              </XRCED>
            </object>
            <option>0</option>
            <flag>wxEXPAND</flag>
          </object>
        </object>
      </object>
    </object>
    <title>Search/Replace</title>
    <icon stock_id="wxART_FIND_AND_REPLACE"/>
    <bg>#EFEFEF</bg>
    <style>wxDEFAULT_DIALOG_STYLE|wxCAPTION|wxSTAY_ON_TOP|wxDIALOG_MODELESS</style>
  </object>
  <object class="wxDialog" name="CheckDlg">
    <style>wxSTAY_ON_TOP|wxDIALOG_MODAL</style>
    <bg>#FFFF80</bg>
    <title/>
    <centered>1</centered>
    <object class="wxBoxSizer">
      <orient>wxVERTICAL</orient>
      <object class="sizeritem">
        <object class="wxBoxSizer">
          <orient>wxHORIZONTAL</orient>
          <object class="sizeritem">
            <object class="wxStaticBitmap" name="bmp1">
              <bitmap>images\pypulsarlogo.gif</bitmap>
            </object>
            <flag>wxALL|wxALIGN_LEFT</flag>
            <border>4</border>
          </object>
          <object class="sizeritem">
            <object class="wxStaticText" name="_VERSION">
              <label>Version 0.2.X</label>
              <fg>#C98301</fg>
              <font>
                <size>14</size>
                <style>normal</style>
                <weight>bold</weight>
                <underlined>0</underlined>
                <family>swiss</family>
                <face>Trebuchet MS</face>
                <encoding>windows-1252</encoding>
              </font>
              <focused>1</focused>
              <style>wxALIGN_RIGHT</style>
            </object>
          </object>
        </object>
        <option>0</option>
        <flag>wxEXPAND</flag>
      </object>
      <object class="sizeritem">
        <option>1</option>
        <flag>wxBOTTOM|wxRIGHT|wxLEFT|wxEXPAND</flag>
        <border>30</border>
        <object class="wxStaticBitmap" name="_BITMAP">
          <size>311,163</size>
          <style>wxTRANSPARENT_WINDOW</style>
          <bg>#FFFF80</bg>
          <bitmap>images\pypulsarsplash.gif</bitmap>
          <focused>1</focused>
        </object>
      </object>
      <object class="sizeritem">
        <object class="wxStaticText" name="_TEXT">
          <size>311,20</size>
          <label>Loading...</label>
          <bg>#FFFF80</bg>
          <font>
            <size>10</size>
            <style>normal</style>
            <weight>bold</weight>
            <underlined>0</underlined>
            <family>swiss</family>
            <face>Tahoma</face>
            <encoding>windows-1252</encoding>
          </font>
          <style>wxNO_BORDER</style>
        </object>
        <option>0</option>
        <flag>wxALL|wxALIGN_CENTRE</flag>
        <border>7</border>
      </object>
      <object class="sizeritem">
        <object class="wxTextCtrl" name="_INFO">
          <size>311,80</size>
          <bg>#FFFF80</bg>
          <style>wxSIMPLE_BORDER|wxTE_AUTO_SCROLL|wxTE_MULTILINE|wxTE_READONLY</style>
          <XRCED>
            <assign_var>1</assign_var>
          </XRCED>
        </object>
        <option>0</option>
        <flag>wxALL|wxGROW</flag>
        <border>10</border>
      </object>
      <object class="sizeritem">
        <object class="wxButton" name="_OKBUTTON">
          <label>Seen</label>
          <XRCED>
            <assign_var>1</assign_var>
          </XRCED>
        </object>
        <option>0</option>
        <flag>wxALL|wxALIGN_RIGHT|wxALIGN_BOTTOM</flag>
        <border>4</border>
      </object>
      <object class="sizeritem">
        <object class="wxStaticText" name="_COPYRIGHT">
          <label>Copyright 2007-2008:  C.Fernandez and J.P.Amoureux</label>
          <fg>#400000</fg>
          <font>
            <size>10</size>
            <style>normal</style>
            <weight>bold</weight>
            <underlined>0</underlined>
            <family>swiss</family>
            <face>Trebuchet MS</face>
            <encoding>windows-1252</encoding>
          </font>
        </object>
        <option>0</option>
        <flag>wxALIGN_CENTRE_HORIZONTAL</flag>
        <border>4</border>
      </object>
    </object>
  </object>
  <object class="wxDialog" name="SplashDlg">
    <object class="wxBoxSizer" name="_TEXT">
      <orient>wxVERTICAL</orient>
      <object class="sizeritem">
        <object class="wxBoxSizer" name="_TEXT">
          <orient>wxHORIZONTAL</orient>
          <object class="sizeritem">
            <object class="wxStaticBitmap" name="bmp1">
              <bitmap>images\pypulsarlogo.gif</bitmap>
            </object>
            <flag>wxALL|wxALIGN_LEFT</flag>
            <border>4</border>
          </object>
          <object class="sizeritem">
            <object class="wxStaticText" name="_VERSION">
              <label>Version 0.2.X</label>
              <fg>#C98301</fg>
              <font>
                <size>14</size>
                <style>normal</style>
                <weight>bold</weight>
                <underlined>0</underlined>
                <family>swiss</family>
                <face>Trebuchet MS</face>
                <encoding>windows-1252</encoding>
              </font>
              <focused>1</focused>
              <style>wxALIGN_RIGHT</style>
            </object>
          </object>
        </object>
        <option>0</option>
        <flag>wxEXPAND</flag>
      </object>
      <object class="sizeritem">
        <object class="wxStaticBitmap" name="_BITMAP">
          <size>311,163</size>
          <bitmap>images\pypulsarsplash.gif</bitmap>
          <bg>#FFFF80</bg>
          <focused>1</focused>
          <style>wxTRANSPARENT_WINDOW</style>
        </object>
        <option>0</option>
        <flag>wxBOTTOM|wxRIGHT|wxLEFT|wxEXPAND</flag>
        <border>30</border>
      </object>
      <object class="sizeritem">
        <object class="wxStaticText" name="_TEXT">
          <label>Loading...</label>
          <bg>#FFFF80</bg>
          <font>
            <size>10</size>
            <style>normal</style>
            <weight>bold</weight>
            <underlined>0</underlined>
            <family>swiss</family>
            <face>Tahoma</face>
            <encoding>windows-1252</encoding>
          </font>
          <style>wxNO_BORDER</style>
        </object>
        <option>0</option>
        <flag>wxALIGN_CENTRE_HORIZONTAL</flag>
        <border>3</border>
      </object>
      <object class="sizeritem">
        <object class="wxStaticText" name="_COPYRIGHT">
          <label>Copyright 2007-2008:  C.Fernandez and J.P.Amoureux</label>
          <fg>#400000</fg>
          <font>
            <size>10</size>
            <style>normal</style>
            <weight>bold</weight>
            <underlined>0</underlined>
            <family>swiss</family>
            <face>Trebuchet MS</face>
            <encoding>windows-1252</encoding>
          </font>
          <focused>1</focused>
          <style>wxALIGN_CENTRE</style>
        </object>
        <flag>wxALIGN_CENTRE_HORIZONTAL</flag>
      </object>
    </object>
    <centered>1</centered>
    <bg>#FFFF80</bg>
    <style>wxFULL_REPAINT_ON_RESIZE|wxSTAY_ON_TOP</style>
  </object>
  <object class="wxPanel" name="project_WizardPage_1">
    <object class="wxBoxSizer">
      <orient>wxVERTICAL</orient>
      <object class="sizeritem">
        <object class="wxBoxSizer">
          <orient>wxVERTICAL</orient>
          <object class="sizeritem">
            <object class="wxStaticText" name="S0">
              <style>wxALIGN_CENTRE</style>
              <font>
                <size>14</size>
                <family>default</family>
                <style>normal</style>
                <weight>bold</weight>
                <underlined>0</underlined>
              </font>
              <label>Create/Open New Project...</label>
            </object>
            <option>1</option>
            <flag>wxBOTTOM|wxEXPAND</flag>
            <border>6</border>
          </object>
          <object class="sizeritem">
            <object class="wxStaticLine" name="xxx"/>
            <option>0</option>
            <flag>wxBOTTOM|wxLEFT|wxRIGHT|wxEXPAND|</flag>
            <border>10</border>
          </object>
        </object>
        <option>0</option>
        <flag>wxEXPAND</flag>
      </object>
      <object class="sizeritem">
        <object class="wxBoxSizer">
          <object class="sizeritem">
            <object class="wxStaticText" name="S1">
              <label>Project name:</label>
            </object>
            <option>0</option>
            <flag>wxALIGN_LEFT</flag>
          </object>
          <orient>wxHORIZONTAL</orient>
          <object class="sizeritem">
            <object class="wxTextCtrl" name="wizprojectname" subclass="common.TextCtrlXRC">
              <value>(Untitled)</value>
              <font>
                <size>8</size>
                <style>normal</style>
                <weight>normal</weight>
                <underlined>0</underlined>
                <family>default</family>
              </font>
              <XRCED>
                <assign_var>1</assign_var>
              </XRCED>
            </object>
            <option>1</option>
            <flag>wxEXPAND</flag>
          </object>
        </object>
        <option>0</option>
        <flag>wxEXPAND</flag>
      </object>
      <object class="spacer">
        <size>0,10</size>
        <option>0</option>
        <flag>wxEXPAND</flag>
      </object>
      <object class="sizeritem">
        <object class="wxBoxSizer">
          <object class="sizeritem">
            <object class="wxCheckBox" name="wizUseDefaultLocation">
              <label>Use default location</label>
              <checked>1</checked>
              <XRCED>
                <assign_var>1</assign_var>
              </XRCED>
            </object>
            <option>1</option>
            <flag>wxALL|wxEXPAND</flag>
            <border>5</border>
          </object>
          <orient>wxHORIZONTAL</orient>
        </object>
        <option>0</option>
        <flag>wxEXPAND</flag>
      </object>
      <object class="spacer">
        <size>0,10</size>
        <option>0</option>
        <flag>wxEXPAND</flag>
      </object>
      <object class="sizeritem">
        <object class="wxBoxSizer">
          <object class="sizeritem">
            <object class="wxStaticText" name="S2">
              <label>Location:</label>
            </object>
            <option>0</option>
            <flag>wxALIGN_LEFT</flag>
          </object>
          <orient>wxHORIZONTAL</orient>
          <object class="sizeritem">
            <object class="wxTextCtrl" name="wizprojectpath" subclass="common.TextCtrlXRC">
              <value>workspace</value>
              <font>
                <size>8</size>
                <style>normal</style>
                <weight>normal</weight>
                <underlined>0</underlined>
                <family>default</family>
              </font>
              <XRCED>
                <assign_var>1</assign_var>
              </XRCED>
            </object>
            <option>1</option>
            <flag>wxEXPAND</flag>
          </object>
        </object>
        <option>0</option>
        <flag>wxEXPAND</flag>
      </object>
      <object class="sizeritem">
        <object class="wxBoxSizer">
          <orient>wxHORIZONTAL</orient>
          <object class="sizeritem">
            <object class="wxButton" name="wizprojectpathBrowse">
              <label>Browse...</label>
              <font>
                <size>8</size>
                <style>normal</style>
                <weight>normal</weight>
                <underlined>0</underlined>
                <family>default</family>
              </font>
              <XRCED>
                <assign_var>1</assign_var>
              </XRCED>
            </object>
            <option>0</option>
            <flag>wxALIGN_RIGHT</flag>
          </object>
        </object>
        <option>0</option>
        <flag>wxALIGN_RIGHT</flag>
      </object>
      <object class="spacer">
        <size>0,10</size>
        <option>0</option>
        <flag>wxEXPAND</flag>
      </object>
      <object class="sizeritem">
        <object class="wxBoxSizer">
          <object class="sizeritem">
            <object class="wxStaticText" name="S3">
              <label>Open an existing project:</label>
              <size>20</size>
              <style/>
            </object>
            <option>0</option>
            <flag>wxEXPAND</flag>
          </object>
          <orient>wxVERTICAL</orient>
          <object class="sizeritem">
            <object class="wxListCtrl" name="wizprojectlist">
              <size>300,75</size>
              <style>wxLC_REPORT|wxLC_SINGLE_SEL</style>
              <XRCED>
                <assign_var>1</assign_var>
              </XRCED>
            </object>
            <option>1</option>
            <flag>wxEXPAND</flag>
          </object>
        </object>
        <option>1</option>
        <flag>wxEXPAND</flag>
      </object>
    </object>
  </object>
  <object class="wxPanel" name="project_WizardPage_2">
    <object class="wxBoxSizer">
      <orient>wxVERTICAL</orient>
      <object class="sizeritem">
        <object class="wxBoxSizer">
          <orient>wxVERTICAL</orient>
          <object class="sizeritem">
            <object class="wxStaticText" name="S4">
              <style>wxALIGN_CENTRE</style>
              <font>
                <size>14</size>
                <family>default</family>
                <style>normal</style>
                <weight>bold</weight>
                <underlined>0</underlined>
              </font>
              <label>Additional informations...</label>
            </object>
            <option>1</option>
            <flag>wxBOTTOM|wxEXPAND</flag>
            <border>6</border>
          </object>
          <object class="sizeritem">
            <object class="wxStaticLine" name="xxx"/>
            <option>0</option>
            <flag>wxBOTTOM|wxLEFT|wxRIGHT|wxEXPAND|</flag>
            <border>10</border>
          </object>
        </object>
        <option>0</option>
        <flag>wxEXPAND</flag>
      </object>
      <object class="sizeritem">
        <object class="wxBoxSizer">
          <object class="sizeritem">
            <object class="wxStaticText" name="S5">
              <label>Description:</label>
            </object>
            <option>0</option>
            <flag>wxEXPAND</flag>
          </object>
          <orient>wxVERTICAL</orient>
          <object class="sizeritem">
            <object class="wxTextCtrl" name="wizprojectdescription" subclass="common.TextCtrlXRC">
              <size>300,200</size>
              <value>None</value>
              <font>
                <size>8</size>
                <style>normal</style>
                <weight>normal</weight>
                <underlined>0</underlined>
                <family>default</family>
              </font>
              <style>wxTE_AUTO_SCROLL|wxTE_MULTILINE</style>
              <XRCED>
                <assign_var>1</assign_var>
              </XRCED>
            </object>
            <option>1</option>
            <flag>wxEXPAND</flag>
          </object>
        </object>
        <option>1</option>
        <flag>wxEXPAND</flag>
      </object>
    </object>
  </object>
  <object class="wxPanel" name="dataset_Page_1">
    <object class="wxBoxSizer">
      <orient>wxVERTICAL</orient>
      <object class="sizeritem">
        <object class="wxBoxSizer">
          <orient>wxVERTICAL</orient>
          <object class="sizeritem">
            <object class="wxBoxSizer">
              <orient>wxHORIZONTAL</orient>
              <object class="sizeritem">
                <object class="wxStaticText">
                  <label>Add a new dataset</label>
                  <font>
                    <size>14</size>
                    <style>normal</style>
                    <weight>bold</weight>
                    <underlined>0</underlined>
                    <family>default</family>
                  </font>
                  <style>wxALIGN_CENTRE</style>
                </object>
                <option>1</option>
                <flag>wxALL|wxEXPAND</flag>
                <border>5</border>
              </object>
              <object class="sizeritem">
                <object class="wxBitmapButton" name="ID_HELP">
                  <bitmap>images\icons\info.gif</bitmap>
                  <style>wxNO_BORDER</style>
                  <XRCED>
                    <assign_var>1</assign_var>
                  </XRCED>
                </object>
                <option>0</option>
                <flag>wxALL|wxALIGN_RIGHT|wxALIGN_CENTRE_VERTICAL</flag>
                <border>5</border>
              </object>
            </object>
            <option>1</option>
            <flag>wxEXPAND</flag>
          </object>
          <object class="sizeritem">
            <object class="wxStaticLine" name=""/>
            <option>0</option>
            <flag>wxALL|wxEXPAND|</flag>
            <border>5</border>
            <minsize>500,1</minsize>
          </object>
        </object>
      </object>
      <object class="sizeritem">
        <object class="wxBoxSizer">
          <object class="sizeritem">
            <object class="wxStaticText" name="">
              <label>Dataset Name: </label>
            </object>
            <option>0</option>
            <flag>wxALL|wxALIGN_LEFT|wxALIGN_CENTRE_VERTICAL</flag>
            <border>5</border>
          </object>
          <orient>wxHORIZONTAL</orient>
          <object class="sizeritem">
            <object class="wxTextCtrl" name="ID_DATASETNAME" subclass="common.TextCtrlXRC">
              <value>Untitled</value>
              <font>
                <size>8</size>
                <style>normal</style>
                <weight>normal</weight>
                <underlined>0</underlined>
                <family>default</family>
              </font>
              <XRCED>
                <assign_var>1</assign_var>
              </XRCED>
            </object>
            <option>1</option>
            <flag>wxALL|wxEXPAND</flag>
            <border>5</border>
          </object>
        </object>
        <option>0</option>
        <flag>wxEXPAND</flag>
      </object>
      <object class="sizeritem">
        <object class="wxBoxSizer">
          <object class="sizeritem">
            <object class="wxStaticText" name="">
              <label>Description:</label>
            </object>
            <option>0</option>
            <flag>wxALL|wxEXPAND</flag>
            <border>5</border>
          </object>
          <orient>wxHORIZONTAL</orient>
          <object class="sizeritem">
            <object class="wxTextCtrl" name="ID_DATASETDESCRIPTION" subclass="common.TextCtrlXRC">
              <font>
                <size>8</size>
                <style>normal</style>
                <weight>normal</weight>
                <underlined>0</underlined>
                <family>default</family>
              </font>
              <style>wxTE_AUTO_SCROLL|wxTE_MULTILINE</style>
              <XRCED>
                <assign_var>1</assign_var>
              </XRCED>
            </object>
            <option>1</option>
            <flag>wxALL|wxEXPAND</flag>
            <border>5</border>
          </object>
        </object>
        <option>0</option>
        <flag>wxEXPAND</flag>
      </object>
      <object class="sizeritem">
        <object class="wxBoxSizer">
          <orient>wxHORIZONTAL</orient>
          <object class="sizeritem">
            <object class="wxCheckBox" name="ID_DATASETTYPE">
              <label>Load an experimental spectrum? </label>
              <XRCED>
                <assign_var>1</assign_var>
              </XRCED>
            </object>
            <option>1</option>
            <flag>wxALL|wxEXPAND</flag>
            <border>5</border>
          </object>
        </object>
        <option>0</option>
        <flag>wxEXPAND</flag>
      </object>
      <object class="sizeritem">
        <object class="wxBoxSizer">
          <orient>wxHORIZONTAL</orient>
          <object class="sizeritem">
            <object class="wxRadioBox" name="ID_EXPERIMENTALFORMAT">
              <label>Format</label>
              <content>
                <item>Bruker</item>
                <item>Varian</item>
              </content>
              <selection>0</selection>
